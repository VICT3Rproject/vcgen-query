{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict3r.org/schemas/grit42.advanced_subject_query.v1.schema.json",
  "title": "Accepted Grit42 advanced subject-query source v1",
  "type": "object",
  "required": ["columns", "condition_tree"],
  "properties": {
    "query_type": {"not": {"const": "form"}},
    "columns": {"$ref": "#/$defs/inventory"},
    "condition_tree": {"$ref": "#/$defs/node"},
    "condition_string": {}
  },
  "additionalProperties": true,
  "$defs": {
    "metadata": {"type": "object"},
    "domainInventory": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "fieldInventory": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/metadata"}},
    "arrayInventory": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "required": ["field"], "properties": {"field": {"type": "string", "minLength": 1}, "valueType": {}}, "additionalProperties": true}]}},
    "inventory": {"oneOf": [{"$ref": "#/$defs/domainInventory"}, {"$ref": "#/$defs/fieldInventory"}, {"$ref": "#/$defs/arrayInventory"}]},
    "children": {"oneOf": [{"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}, {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/node"}}]},
    "group": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "group"},
        "properties": {"type": "object", "required": ["conjunction"], "properties": {"conjunction": {"type": "string"}, "not": {"type": "boolean"}}, "additionalProperties": true},
        "children": {"$ref": "#/$defs/children"},
        "children1": {"$ref": "#/$defs/children"}
      },
      "additionalProperties": true,
      "oneOf": [{"required": ["children"], "not": {"required": ["children1"]}}, {"required": ["children1"], "not": {"required": ["children"]}}]
    },
    "rule": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "rule"},
        "properties": {"type": "object", "required": ["field", "operator"], "properties": {"field": {"type": "string", "minLength": 1}, "operator": {"type": "string", "minLength": 1}, "value": {}, "valueType": {"oneOf": [{"type": "string"}, {"type": "array", "maxItems": 1, "items": {"type": "string"}}]}, "valueSrc": {"oneOf": [{"type": "string"}, {"type": "array", "maxItems": 1, "items": {"type": "string"}}]}}, "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "node": {"oneOf": [{"$ref": "#/$defs/group"}, {"$ref": "#/$defs/rule"}]}
  }
}
