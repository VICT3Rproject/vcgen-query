{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict3r.org/schemas/vcgen.cohort_query.v5.schema.json",
  "title": "VCGen cohort query v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "query_id", "requested_endpoints", "endpoint_catalogue"],
  "properties": {
    "contract": {"const": "vcgen.cohort_query.v5"},
    "query_id": {"type": "string", "minLength": 1},
    "predicate": {"$ref": "https://vict3r.org/schemas/vcgen.subject_predicate.v1.schema.json"},
    "requested_endpoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "endpoint_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "catalogue_id", "sha256"],
      "properties": {
        "contract": {"const": "vcgen.canonical_endpoint_catalogue.v4"},
        "catalogue_id": {"const": "grit42-canonical-endpoints-2026-09-17-v4"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "import_provenance": {"$ref": "https://vict3r.org/schemas/grit42.subject_query_import.v1.schema.json"},
    "source_identity": {"type": "string", "minLength": 1},
    "assumptions": {"$ref": "#/$defs/notes"},
    "warnings": {"$ref": "#/$defs/notes"}
  },
  "$defs": {
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
