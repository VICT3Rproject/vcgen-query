{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict3r.org/schemas/vcgen.cohort_query.v4.schema.json",
  "title": "VCGen cohort query v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "query_id"
  ],
  "properties": {
    "contract": {
      "const": "vcgen.cohort_query.v4"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "$ref": "https://vict3r.org/schemas/vcgen.subject_predicate.v1.schema.json"
    },
    "observation_contract": {
      "$ref": "#/$defs/observationContract"
    },
    "import_provenance": {
      "$ref": "https://vict3r.org/schemas/grit42.subject_query_import.v1.schema.json"
    },
    "source_identity": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "$ref": "#/$defs/notes"
    },
    "warnings": {
      "$ref": "#/$defs/notes"
    }
  },
  "$defs": {
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "dayWindow": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "test_codes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "domain": {
          "$ref": "#/$defs/identifier"
        },
        "test_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "specimen_match": {
          "enum": [
            "exact",
            "contains",
            "not"
          ]
        },
        "sexes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "day_window": {
          "$ref": "#/$defs/dayWindow"
        },
        "target_unit": {
          "type": "string",
          "enum": [
            "1",
            "%",
            "L/L",
            "10^9/L",
            "10^12/L",
            "L",
            "mL",
            "fL",
            "mol",
            "fmol",
            "mol/L",
            "mmol/L",
            "g",
            "mg",
            "kg",
            "g/L",
            "g/dL",
            "mg/L",
            "mg/dL",
            "s",
            "min",
            "kat/L",
            "ukat/L",
            "nkat/L",
            "U/L",
            "K",
            "Cel"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "target_unit"
            ]
          },
          "then": {
            "required": [
              "source_units"
            ],
            "properties": {
              "source_units": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "observationContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        }
      }
    }
  }
}
