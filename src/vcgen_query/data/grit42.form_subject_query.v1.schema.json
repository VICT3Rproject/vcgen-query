        "dose_duration_min": {"$ref": "#/$defs/bound"}, "dose_duration_max": {"$ref": "#/$defs/bound"}, "study_start_year_min": {"$ref": "#/$defs/bound"}, "study_start_year_max": {"$ref": "#/$defs/bound"}, "age_init_min": {"$ref": "#/$defs/bound"}, "age_init_max": {"$ref": "#/$defs/bound"}, "bodytemp_init_min": {"$ref": "#/$defs/bound"}, "bodytemp_init_max": {"$ref": "#/$defs/bound"}, "bw_init_min_male": {"$ref": "#/$defs/bound"}, "bw_init_max_male": {"$ref": "#/$defs/bound"}, "bw_init_min_female": {"$ref": "#/$defs/bound"}, "bw_init_max_female": {"$ref": "#/$defs/bound"},
