        "ecg_init_min": {"$ref": "#/$defs/bound"}, "ecg_init_max": {"$ref": "#/$defs/bound"}, "lbtest": {"$ref": "#/$defs/stringList"}, "pretestvalues": {"anyOf": [{"type": "array"}, {"type": "object"}, {"$ref": "#/$defs/inactive"}]}, "trtvcat": {"$ref": "#/$defs/stringList"}
